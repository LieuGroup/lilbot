{
  "name": "lilbot",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "bun server/main.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "verify": "biome check . && tsc --noEmit && bun test tests && vite build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test tests",
    "check:restart": "bun live-checks/restart-check.ts",
    "check:threads": "bun live-checks/threads-check.ts",
    "build:helper": "bun scripts/build-helper.ts",
    "check:computers": "bun live-checks/computers-check.ts",
    "check:skills": "bun live-checks/skills-check.ts",
    "check:access": "bun live-checks/access-check.ts",
    "check:live": "bun live-checks/chat-check.ts",
    "check:routines": "bun live-checks/routines-check.ts",
    "check:memory": "bun live-checks/memory-check.ts",
    "check:coding": "bun live-checks/coding-check.ts",
    "t3:sign-in": "bun server/connections/t3-sign-in-cli.ts",
    "dev:setup": "bun scripts/dev-setup.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "jose": "^6.2.18",
    "lucide-react": "^1.73.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.0",
    "vite": "latest"
  }
}
