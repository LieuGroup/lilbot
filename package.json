{
  "name": "lilbot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "bun server/main.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "verify": "biome check . && tsc --noEmit && bun test tests && vite build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test tests",
    "check:live": "bun scripts/live-check.ts",
    "check:memory": "bun scripts/memory-live-check.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.0",
    "vite": "latest"
  }
}
