# LilBot server configuration (copy to .env or pass via systemd/shell environment).
# Every variable is optional unless marked required. Never commit real secrets or hostnames.

# --- Core & paths ---
# Required: "development" or "production" (startup refuses to run without an explicit value).
LILBOT_ENV=development
# Loopback address all listeners bind to.
LILBOT_HOST=127.0.0.1
# Private app listener port (production default: 3370; Vite dev proxy default: 3371).
# Development refuses production ports (3370, 3372, 3373).
LILBOT_PORT=3371
# Comma-separated extra host:port values allowed for browser/WebSocket access (e.g. a private tailnet address).
# Never add the helper door or Cloudflare Access hostname here.
# LILBOT_ALLOWED_HOSTS=lilbot.example.internal:8443
# SQLite database, engine token, credentials, and helper download storage (default: ~/.local/share/lilbot).
# Development requires this directory under ~/lilbot-dev/.
LILBOT_DATA_DIR=$HOME/lilbot-dev/data
# Per-bot workspace root directory (default: ~/lilbot/workspaces).
# Development requires this directory under ~/lilbot-dev/.
LILBOT_WORKSPACES_DIR=$HOME/lilbot-dev/workspaces
# Shared SKILL.md library directory (default: ~/lilbot/skills).
# Development requires this directory under ~/lilbot-dev/.
LILBOT_SKILLS_DIR=$HOME/lilbot-dev/skills

# --- Engine (Hermes) ---
# Hermes gateway home directory (default: ~/.hermes; required under ~/lilbot-dev/ in development).
HERMES_HOME=$HOME/lilbot-dev/hermes
# Hermes gateway lock directory (required under ~/lilbot-dev/ in development).
HERMES_GATEWAY_LOCK_DIR=$HOME/lilbot-dev/hermes-locks
# Path or command name of the Hermes CLI binary (default: hermes).
# LILBOT_HERMES_BIN=hermes

# --- Memory review & same-bot checks ---
# Set to "off" to disable after-chat memory reviews (enabled by default).
# LILBOT_REVIEW=on
# Optional "provider::model" for after-chat memory reviews, pre-compaction saves, and same-bot checks.
# LILBOT_REVIEW_MODEL=provider::model-name
# Queued conversation turns before starting an after-chat memory review (default: 10).
# LILBOT_REVIEW_TURNS=10
# Idle seconds before reviewing 3 or more queued turns (default: 120).
# LILBOT_REVIEW_QUIET_SECONDS=120

# --- Coding (T3 Code) ---
# Upstream T3 Code MCP server URL (default: http://127.0.0.1:3773/mcp).
# LILBOT_T3_MCP_URL=http://127.0.0.1:3773/mcp

# --- Optional helper door & webhooks (off by default) ---
# Set to 1 to enable the separate loopback listener for remote computer helpers and webhooks.
LILBOT_PUBLIC_ENABLED=0
# Loopback port for the helper/webhook listener (default: 3372; must differ from LILBOT_PORT).
# LILBOT_PUBLIC_PORT=3372
# Public HTTPS origin of the helper door (enables webhook URLs and helper installer downloads).
# LILBOT_HELPER_URL=https://helper.example.com

# --- Optional Cloudflare Access listener (off by default) ---
# Set to 1 to enable the separate loopback listener guarded by Cloudflare Access RS256 JWTs.
LILBOT_ACCESS_ENABLED=0
# Loopback port for the Access listener (required when enabled; must differ from private and helper ports).
# LILBOT_ACCESS_PORT=3373
# Public hostname served through Cloudflare Access (required when enabled).
# LILBOT_ACCESS_HOST=app.example.com
# Cloudflare Access team domain in "<team>.cloudflareaccess.com" format (required when enabled).
# LILBOT_ACCESS_TEAM=your-team.cloudflareaccess.com
# Cloudflare Access application audience (AUD) tag (required when enabled).
# LILBOT_ACCESS_AUD=replace-with-cloudflare-access-aud-tag
# Single authorized email address verified against Access JWT claims (required when enabled).
# LILBOT_ACCESS_EMAIL=you@example.com
# Set to 1 to mount GET /api/connections/callback on the Access listener for MCP OAuth returns (default: 0).
# LILBOT_ACCESS_CALLBACK_ENABLED=0

# --- Deploy CLI (bun run deploy) ---
# Immutable release build root (default: ~/lilbot/releases).
# LILBOT_RELEASES_DIR=$HOME/lilbot/releases
# Symlink pointing at the active release (default: ~/lilbot/release).
# LILBOT_RELEASE_LINK=$HOME/lilbot/release
# Systemd user service restarted during deployment (default: lilbot.service).
# LILBOT_DEPLOY_UNIT=lilbot.service
# Systemd oneshot watchdog service name (default: lilbot-deploy.service).
# LILBOT_DEPLOY_WATCHDOG_UNIT=lilbot-deploy.service
# Health URL polled after restart (default: http://127.0.0.1:3370/api/health).
# LILBOT_DEPLOY_HEALTH_URL=http://127.0.0.1:3370/api/health

# --- Development & isolated check overrides (refused when LILBOT_ENV=production) ---
# Comma-separated engine profile allowlist for isolated dev/test servers.
# LILBOT_BOT_IDS=dev-example
# Set to 1 to skip startup memory-adapter changes on existing profiles.
# LILBOT_SKIP_MEMORY_SETUP=1
# Explicit port override used by scripts/dev-env.ts live checks.
# LILBOT_CHECK_PORT=3379
# Short routine minimum interval in seconds for isolated checks (requires LILBOT_DATA_DIR and LILBOT_BOT_IDS).
# LILBOT_ROUTINE_TEST_INTERVAL_SECONDS=5
# Group round-limit override for isolated checks (requires LILBOT_DATA_DIR and LILBOT_BOT_IDS).
# LILBOT_GROUP_TEST_ROUNDS=2
# MCP OAuth sign-in timeout override in seconds for isolated checks (requires LILBOT_DATA_DIR and LILBOT_BOT_IDS).
# LILBOT_CONNECTION_TEST_SIGN_IN_SECONDS=10
# Loopback HTTP JWKS endpoint override for isolated Access checks only.
# LILBOT_ACCESS_TEST_CERTS_URL=http://127.0.0.1:41234/certs
# Optional "provider::model" override for live checks.
# LILBOT_LIVE_MODEL=provider::model-name
