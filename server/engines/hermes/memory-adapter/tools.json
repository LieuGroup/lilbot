[
  {
    "name": "recall_memory",
    "description": "Search long-term memory for facts not shown above. Returns id, kind, date, text.",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search words; empty lists newest."
        },
        "kind": {
          "type": "string",
          "enum": ["profile", "journal"]
        },
        "limit": {
          "type": "integer",
          "description": "Max results (default 20, max 50)."
        }
      },
      "required": []
    }
  },
  {
    "name": "update_memory",
    "description": "Save or forget one long-term memory fact. To correct: forget old, write new.",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["write", "forget"]
        },
        "kind": {
          "type": "string",
          "enum": ["profile", "journal"],
          "description": "write: profile (lasting) or journal (dated)"
        },
        "fact": {
          "type": "string",
          "description": "write: 1-2 sentences"
        },
        "scope": {
          "type": "string",
          "enum": ["bot", "shared"],
          "description": "write: bot (only you) or shared"
        },
        "expires": {
          "type": "string",
          "description": "write: expiry YYYY-MM-DD"
        },
        "id": {
          "type": "string",
          "description": "forget: fact id in brackets"
        }
      },
      "required": ["action"]
    }
  }
]
