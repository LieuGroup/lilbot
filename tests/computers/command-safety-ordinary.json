  "git commit -m \"$(cat <<'EOF'\nFix bug: don't crash when the user's session isn't ready\nEOF\n)\"",
  "git commit -m \"$(cat <<'EOF'\nHarden parser: handle nested $(cat <<'INNER') and apostrophes\n\nIt's safe to quote \"rm -rf /\", `reboot`, and $HOME in commit bodies.\nCloses #123 (see notes)\nEOF\n)\"",
  "git commit -m \"$(cat <<'EOF'\nRefactor: it's cleaner when we don't split `{}` inside find\n\nAlso tested:\n- `rm -rf /` refused\n- `shutdown -h now` refused\n- `cat f > /dev/sda` refused\n- `:(){ :|:& };:` refused\n)\nEOF\n)\"",
  "gh pr create --title \"Fix: don't refuse ordinary heredoc commits\" --body \"$(cat <<'EOF'\n## Summary\n\n- Fixes a false positive where `git commit -m \"$(cat <<'EOF'...)\"` failed if it contained \"don't\" or \"it's\".\n- Ensures `(cd ~ && ls); (rm -rf *)` doesn't leak cwd.\n- Verifies `kill -1 12345` (SIGHUP) works.\n\n## Test plan\n- [x] `bun run verify`\n- [x] `bun test tests/computers/`\nEOF\n)\"",
  "gh pr edit 251 --body \"$(cat <<'EOF'\nUpdated PR body: it's now green.\nNote: don't run `rm -rf /` or `mkfs /dev/sda` in production.\nEOF\n)\"",
  "gh issue comment 42 --body \"$(cat <<'EOF'\nHere's what we found:\n1) Can't reproduce after clearing `~/project/dist`.\n2) Didn't touch `/etc` or `/var`.\n3) Won't need a host reboot.\nEOF\n)\"",
  "gh release create v1.2.3 --notes \"$(cat <<'EOF'\nWhat's changed:\n- Don't fail on user's quotes (e.g. \"hello\", 'world', `code`)\n- Support $ENV_VAR expansion in config\nEOF\n)\"",
