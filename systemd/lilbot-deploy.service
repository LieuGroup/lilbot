[Unit]
Description=LilBot deployment and one-shot rollback watchdog

[Service]
Type=oneshot
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.bun/bin/bun %h/.local/share/lilbot/deploy/runner/watchdog.ts %h/.local/share/lilbot/deploy/job.json
TimeoutStartSec=8min
Restart=no
UMask=0077
